# Copy to .env.local and fill in. Do not commit real values.

# --- Upstash Redis (presence KV store) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Spotify presence ---
# See scripts/spotify-token/ for generating a refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# --- Discord presence (Lanyard) ---
# Discord user ID; the user must be in discord.gg/lanyard.
DISCORD_USER_ID=

# --- Presence write API ---
# Bearer token required by POST /api/presence/update. Generate a random string.
PRESENCE_WRITE_TOKEN=
