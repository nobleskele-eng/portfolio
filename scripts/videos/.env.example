# Copy to .env and fill in. In the Cloudflare dashboard: R2 > Manage API
# tokens > Create API token, with Object Read & Write on the bucket below.
# The account ID is shown on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stayvyxed-media
# The bucket's custom domain (R2 > bucket > Settings > Custom Domains)
MEDIA_BASE_URL=https://media.stayvyxed.com
